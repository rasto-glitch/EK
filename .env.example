# Resend API key — required for the contact form to deliver mail.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides (defaults shown). CONTACT_FROM must use a domain verified
# in Resend — that's scholify.krd (elkurdi.co is not on the Resend account).
# contact@elkurdi.co receives via Cloudflare Email Routing → Gmail forward.
CONTACT_TO=contact@elkurdi.co
CONTACT_FROM=EK Website <noreply@scholify.krd>
