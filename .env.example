# URL of the deployed Cloudflare contact worker (cloudflare/contact-worker).
# Required for the contact form to deliver mail — e.g.
# https://ek-contact-worker.<your-subdomain>.workers.dev
CONTACT_WORKER_URL=

# Optional shared secret. If set, must match the CONTACT_SECRET secret on the
# worker (`wrangler secret put CONTACT_SECRET`).
CONTACT_WORKER_SECRET=
